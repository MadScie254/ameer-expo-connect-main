# Pesapal Sandbox Credentials
PESAPAL_CONSUMER_KEY=your_sandbox_key
PESAPAL_CONSUMER_SECRET=your_sandbox_secret
PESAPAL_IPN_ID=your_ipn_id

# Application URL for callbacks
PUBLIC_APP_URL=http://localhost:3000

# Supabase (server-only — service role key must NEVER be exposed to the client)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
