# Pesapal Sandbox Credentials
PESAPAL_CONSUMER_KEY=your_sandbox_key
PESAPAL_CONSUMER_SECRET=your_sandbox_secret
PESAPAL_IPN_ID=your_ipn_id

# Application URL for callbacks
PUBLIC_APP_URL=http://localhost:3000

# Supabase (server-only — service role key must NEVER be exposed to the client)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Admin notification email (Resend)
RESEND_API_KEY=
ADMIN_NOTIFICATION_EMAIL=info@ameergroupltd.com
SECOND_NOTIFICATION_EMAIL=dmwanjala254@gmail.com

# Set to production before going live
PESAPAL_ENV=sandbox
